archetype (adl_version=1.4; uid=f1a2b3c4-d5e6-7890-abcd-ef1234567890)
	openEHR-EHR-OBSERVATION.groningen_frailty_indicator_nl.v0

concept
	[at0000]	-- Groningen Frailty Indicator (GFI)

language
	original_language = <[ISO_639-1::nl]>
	translations = <
		["en"] = <
			language = <[ISO_639-1::en]>
			author = <
				["name"] = <"Erik-Jan Vlieger">
			>
		>
	>

description
	original_author = <
		["name"] = <"Erik-Jan Vlieger">
		["organisation"] = <"Sensire">
		["date"] = <"2026-08-18">
	>
	details = <
		["nl"] = <
			language = <[ISO_639-1::nl]>
			purpose = <"Vastleggen van de Groningen Frailty Indicator (GFI) score, een gevalideerd screeningsinstrument om kwetsbaarheid (frailty) bij ouderen en cliënten in de wijkverpleging te meten over vier domeinen: fysiek, cognitief, sociaal en psychisch.">
			use = <"Gebruik binnen het Sensii verpleegkundig proces en wijkverpleegkundige anamnese. Score loopt van 0 tot 15. Een score van 4 of hoger duidt op matige tot ernstige kwetsbaarheid.">
			misuse = <"Niet gebruiken als vervanging voor een uitgebreid Geriatrisch Assessment.">
			keywords = <"GFI", "Groningen Frailty Indicator", "kwetsbaarheid", "frailty", "ouderenzorg", "Sensii", "wijkverpleging">
			copyright = <"© 2026 Sensire">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Recording the Groningen Frailty Indicator (GFI) score to assess frailty in elderly and home care clients across physical, cognitive, social, and psychological domains.">
			use = <"Used within nursing assessment and care pathways. Total score 0-15; score >= 4 indicates frailty.">
			keywords = <"GFI", "frailty", "geriatric assessment", "nursing">
			copyright = <"© 2026 Sensire">
		>
	>
	lifecycle_state = <"in_development">

definition
	OBSERVATION[at0000] matches {	-- Groningen Frailty Indicator (GFI)
		data matches {
			HISTORY[at0001] matches {	-- Event Series
				events cardinality matches {1..*; unordered} matches {
					EVENT[at0002] occurrences matches {0..*} matches {	-- Elk evenement
						data matches {
							ITEM_TREE[at0003] matches {	-- Boom
								items cardinality matches {0..*; unordered} matches {
									CLUSTER[at0004] occurrences matches {0..1} matches {	-- Fysiek domein
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0005] occurrences matches {0..1} matches {	-- Boodschappen doen
												value matches {
													0|[local::at0006],	-- Zelfstandig zonder hulp (0 pt)
													1|[local::at0007] 	-- Helemaal niet of met hulp (1 pt)
												}
											}
											ELEMENT[at0008] occurrences matches {0..1} matches {	-- Buitenshuis rondlopen
												value matches {
													0|[local::at0009],	-- Zelfstandig zonder hulp (0 pt)
													1|[local::at0010] 	-- Helemaal niet of met hulp (1 pt)
												}
											}
											ELEMENT[at0011] occurrences matches {0..1} matches {	-- Aan- en uitkleden
												value matches {
													0|[local::at0012],	-- Zelfstandig zonder hulp (0 pt)
													1|[local::at0013] 	-- Helemaal niet of met hulp (1 pt)
												}
											}
											ELEMENT[at0014] occurrences matches {0..1} matches {	-- Naar het toilet gaan
												value matches {
													0|[local::at0015],	-- Zelfstandig zonder hulp (0 pt)
													1|[local::at0016] 	-- Helemaal niet of met hulp (1 pt)
												}
											}
											ELEMENT[at0017] occurrences matches {0..1} matches {	-- Fysieke conditie / fitheid
												value matches {
													0|[local::at0018],	-- Goed tot uitstekend (0 pt)
													1|[local::at0019] 	-- Matig tot slecht (1 pt)
												}
											}
											ELEMENT[at0020] occurrences matches {0..1} matches {	-- Zichtbeperking
												value matches {
													0|[local::at0021],	-- Geen belemmering (0 pt)
													1|[local::at0022] 	-- Belemmering in dagelijks leven (1 pt)
												}
											}
											ELEMENT[at0023] occurrences matches {0..1} matches {	-- Gehoorbeperking
												value matches {
													0|[local::at0024],	-- Geen belemmering (0 pt)
													1|[local::at0025] 	-- Belemmering in dagelijks leven (1 pt)
												}
											}
											ELEMENT[at0026] occurrences matches {0..1} matches {	-- Gewichtsverlies
												value matches {
													0|[local::at0027],	-- Geen onbedoeld gewichtsverlies (0 pt)
													1|[local::at0028] 	-- Onbedoeld afgevallen afgelopen 6 mnd (1 pt)
												}
											}
											ELEMENT[at0029] occurrences matches {0..1} matches {	-- Medicijngebruik (>= 4 soorten)
												value matches {
													0|[local::at0030],	-- Minder dan 4 soorten medicijnen (0 pt)
													1|[local::at0031] 	-- 4 of meer verschillende medicijnen (1 pt)
												}
											}
										}
									}
									CLUSTER[at0032] occurrences matches {0..1} matches {	-- Cognitief domein
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0033] occurrences matches {0..1} matches {	-- Geheugenklachten
												value matches {
													0|[local::at0034],	-- Geen geheugenklachten (0 pt)
													1|[local::at0035] 	-- Soms of regelmatig geheugenklachten (1 pt)
												}
											}
										}
									}
									CLUSTER[at0036] occurrences matches {0..1} matches {	-- Sociaal domein
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0037] occurrences matches {0..1} matches {	-- Ervaren van leegte
												value matches {
													0|[local::at0038],	-- Nooit of zelden (0 pt)
													1|[local::at0039] 	-- Soms tot vaak (1 pt)
												}
											}
											ELEMENT[at0040] occurrences matches {0..1} matches {	-- Mensen om zich heen missen
												value matches {
													0|[local::at0041],	-- Nooit of zelden (0 pt)
													1|[local::at0042] 	-- Soms tot vaak (1 pt)
												}
											}
											ELEMENT[at0043] occurrences matches {0..1} matches {	-- In de steek gelaten voelen
												value matches {
													0|[local::at0044],	-- Nooit of zelden (0 pt)
													1|[local::at0045] 	-- Soms tot vaak (1 pt)
												}
											}
										}
									}
									CLUSTER[at0046] occurrences matches {0..1} matches {	-- Psychisch domein
										items cardinality matches {1..*; unordered} matches {
											ELEMENT[at0047] occurrences matches {0..1} matches {	-- Somberheid / neerslachtigheid
												value matches {
													0|[local::at0048],	-- Nooit of zelden (0 pt)
													1|[local::at0049] 	-- Soms tot vaak (1 pt)
												}
											}
											ELEMENT[at0050] occurrences matches {0..1} matches {	-- Nerveus of angstig gevoel
												value matches {
													0|[local::at0051],	-- Nooit of zelden (0 pt)
													1|[local::at0052] 	-- Soms tot vaak (1 pt)
												}
											}
										}
									}
									ELEMENT[at0053] occurrences matches {0..1} matches {	-- GFI Totaalscore
										value matches {
											DV_COUNT matches {
												magnitude matches {|0..15|}
											}
										}
									}
									ELEMENT[at0054] occurrences matches {0..1} matches {	-- Interpretatie kwetsbaarheid
										value matches {
											DV_CODED_TEXT matches {
												defining_code matches {
													[local::
													at0055, 	-- Niet kwetsbaar (score 0-3)
													at0056]	-- Kwetsbaar (score >= 4)
												}
											}
										}
									}
									ELEMENT[at0057] occurrences matches {0..1} matches {	-- Toelichting
										value matches {
											DV_TEXT matches {*}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

