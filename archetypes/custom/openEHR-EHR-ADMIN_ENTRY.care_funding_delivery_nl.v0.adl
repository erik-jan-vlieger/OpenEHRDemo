				>
				["at0003"] = <
					text = <"Zorgverzekeringswet (Zvw - Wijkverpleging)">
					description = <"Zorgverzekeringswet, geen eigen bijdrage.">
				>
				["at0004"] = <
					text = <"Wet langdurige zorg (Wlz)">
					description = <"Langdurige intensieve zorg, eigen bijdrage CAK van toepassing.">
				>
				["at0005"] = <
