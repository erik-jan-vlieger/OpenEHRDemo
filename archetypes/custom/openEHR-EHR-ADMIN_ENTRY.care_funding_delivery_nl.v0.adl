archetype (adl_version=1.4; uid=f7a8b9c0-a1b2-3456-defa-ef7890123456)
	openEHR-EHR-ADMIN_ENTRY.care_funding_delivery_nl.v0

concept
	[at0000]	-- Zorgfinanciering en leveringsvorm

language
	original_language = <[ISO_639-1::nl]>
	translations = <
		["en"] = <
			language = <[ISO_639-1::en]>
			author = <
				["name"] = <"Erik-Jan Vlieger">
			>
		>
	>

description
	original_author = <
		["name"] = <"Erik-Jan Vlieger">
		["organisation"] = <"Sensire">
		["date"] = <"2026-08-18">
	>
	details = <
		["nl"] = <
			language = <[ISO_639-1::nl]>
			purpose = <"Vastleggen van de financieringsvorm, wettelijk kader (Zvw, Wlz, Wmo), leveringsvorm (ZIN, PGB, VPT, MPT) en omvang van de toegekende zorg in uren/minuten conform het Sensii verpleegkundig proces.">
			use = <"Gebruik in Hoofdstuk 3 (Organiseren van zorg) om de administratieve en financiële randvoorwaarden van het zorgplan formeel vast te leggen.">
			keywords = <"financiering", "leveringsvorm", "Zvw", "Wlz", "Wmo", "ZIN", "PGB", "Sensii", "wijkverpleging">
			copyright = <"© 2026 Sensire">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Recording healthcare funding framework, delivery method, and allocated care duration in home care.">
			use = <"Used to document administrative and legal funding boundaries of the nursing care plan.">
			keywords = <"funding", "care delivery", "reimbursement", "home care">
			copyright = <"© 2026 Sensire">
		>
	>
	lifecycle_state = <"in_development">

definition
	ADMIN_ENTRY[at0000] matches {	-- Zorgfinanciering en leveringsvorm
		data matches {
			ITEM_TREE[at0001] matches {	-- Boom
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] matches {	-- Wettelijk financieringskader
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003, 	-- Zorgverzekeringswet (Zvw - Wijkverpleging)
									at0004, 	-- Wet langdurige zorg (Wlz)
									at0005, 	-- Wet maatschappelijke ondersteuning (Wmo)
									at0006, 	-- Jeugdwet
									at0007]	-- Particulier / Zelfbekostigd
								}
							}
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {	-- Leveringsvorm
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0009, 	-- Zorg in Natura (ZIN)
									at0010, 	-- Persoonsgebonden budget (PGB)
									at0011, 	-- Volledig Pakket Thuis (VPT)
									at0012, 	-- Modulair Pakket Thuis (MPT)
									at0013]	-- Combinatie ZIN en PGB
								}
							}
						}
					}
					ELEMENT[at0014] occurrences matches {0..1} matches {	-- Geplande zorgduur per week (minuten)
						value matches {
							DV_COUNT matches {
								magnitude matches {|0..10000|}
							}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {	-- Inzet beeldschermzorg / eHealth
						value matches {
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0016] occurrences matches {0..1} matches {	-- Wlz-indicatieprofiel / Zorgzwaartepakket (ZZP)
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0017] occurrences matches {0..1} matches {	-- Financiële consequenties voor cliënt
						value matches {
							DV_TEXT matches {*}
						}
					}
					ELEMENT[at0018] occurrences matches {0..1} matches {	-- Toelichting financiering
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

