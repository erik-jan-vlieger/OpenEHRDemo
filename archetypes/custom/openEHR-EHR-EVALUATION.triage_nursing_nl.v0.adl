					text = <"Boom">
					description = <"@ internal @">
				>
				["at0002"] = <
					text = <"Passendheid voor wijkverpleging">
					description = <"Beoordeling of de vraag binnen het domein van wijkverpleging valt.">
				>
				["at0003"] = <
					text = <"Passend voor wijkverpleging">
					description = <"Zorgvraag sluit aan bij aanspraak wijkverpleging (Zvw).">
				>
				["at0004"] = <
					text = <"Niet passend (verwijzen naar voorliggend veld / sociaal domein)">
