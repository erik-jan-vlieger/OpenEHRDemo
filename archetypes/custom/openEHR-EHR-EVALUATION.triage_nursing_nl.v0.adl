archetype (adl_version=1.4; uid=f5a6b7c8-e9f0-1234-defa-cd5678901234)
	openEHR-EHR-EVALUATION.triage_nursing_nl.v0

concept
	[at0000]	-- Wijkverpleegkundige Triage

language
	original_language = <[ISO_639-1::nl]>
	translations = <
		["en"] = <
			language = <[ISO_639-1::en]>
			author = <
				["name"] = <"Erik-Jan Vlieger">
			>
		>
	>

description
	original_author = <
		["name"] = <"Erik-Jan Vlieger">
		["organisation"] = <"Sensire">
		["date"] = <"2026-08-18">
	>
	details = <
		["nl"] = <
			language = <[ISO_639-1::nl]>
			purpose = <"Vastleggen van de verpleegkundige triage bij aanmelding voor wijkverpleging conform Sensii.">
			use = <"Gebruik in de triagefase om vast te stellen of een zorgvraag passend is voor wijkverpleging, wat de urgentie is en of een Verpleegkundig Adviesgesprek (VAG) moet worden gepland.">
			keywords = <"triage", "wijkverpleging", "aanmelding", "urgentie", "Sensii", "toegankelijkheid">
			copyright = <"© 2026 Sensire">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Recording home care nursing triage upon intake and referral.">
			use = <"Used to evaluate appropriateness of home care, urgency category, and next steps.">
			keywords = <"triage", "home care", "intake", "urgency">
			copyright = <"© 2026 Sensire">
		>
	>
	lifecycle_state = <"in_development">

definition
	EVALUATION[at0000] matches {	-- Wijkverpleegkundige Triage
		data matches {
			ITEM_TREE[at0001] matches {	-- Boom
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0002] matches {	-- Passendheid voor wijkverpleging
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0003, 	-- Passend voor wijkverpleging
									at0004, 	-- Niet passend (verwijzen naar voorliggend veld / sociaal domein)
									at0005, 	-- Specialistische / ziekenhuiszorg vereist
									at0006]	-- Acute medische beoordeling vereist (huisarts/SEH)
								}
							}
						}
					}
					ELEMENT[at0007] occurrences matches {0..1} matches {	-- Urgentiecategorie
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0008, 	-- Planbare zorg (binnen reguliere termijn)
									at0009, 	-- Dringende zorg (binnen 24-48 uur)
									at0010]	-- Urgente zorg (direct / dezelfde dag)
								}
							}
						}
					}
					ELEMENT[at0011] occurrences matches {0..1} matches {	-- Verwachte zorgrelatie
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0012, 	-- Intensieve langdurige relatie (Langer thuis route)
									at0013, 	-- Laagfrequente langdurige relatie
									at0014]	-- Kortdurend / incidenteel hersteltraject
								}
							}
						}
					}
					ELEMENT[at0015] occurrences matches {0..1} matches {	-- Vervolgstap / Advies
						value matches {
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0016, 	-- Verpleegkundig adviesgesprek (VAG) inplannen
									at0017, 	-- Directe intake en anamnese starten
									at0018, 	-- Warme overdracht / Terugkoppeling aanvrager
									at0019]	-- Geen verdere actie wijkverpleging
								}
							}
						}
					}
					ELEMENT[at0020] occurrences matches {0..1} matches {	-- Toelichting triagebesluit
						value matches {
							DV_TEXT matches {*}
						}
					}
				}
			}
		}
	}

