					description = <"Klinische observaties en uitspraken van de cliënt.">
				>
				["at0007"] = <
					text = <"2. Voedings- en stofwisselingspatroon">
					description = <"Eet- en drinkpatroon, gewicht, huidconditie, gebit en eetlust.">
				>
				["at0008"] = <
					text = <"Afwijking of risico aanwezig">
					description = <"Aandachtspunt aanwezig.">
				>
				["at0009"] = <
