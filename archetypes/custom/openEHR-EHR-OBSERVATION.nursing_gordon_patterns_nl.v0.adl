					description = <"Observaties slaap en rust.">
				>
				["at0019"] = <
					text = <"6. Cognitief en waarnemingspatroon">
					description = <"Geheugen, oriëntatie, zintuiglijke waarneming, pijn, oordeelsvorming.">
