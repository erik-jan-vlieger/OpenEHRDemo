	details = <
		["nl"] = <
			language = <[ISO_639-1::nl]>
			purpose = <"Systematisch vastleggen van de verpleegkundige anamnese volgens de 11 functionele gezondheidspatronen van Gordon, zoals toegepast in Sensii.">
			use = <"Gebruik tijdens de anamnesefase (Hoofdstuk 2 van Sensii) ter inventarisatie van gezondheidsproblemen, risico's en belemmeringen per patroon.">
			keywords = <"Gordon", "gezondheidspatronen", "anamnese", "verpleegkundig proces", "Sensii", "wijkverpleging">
			copyright = <"© 2026 Sensire">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"Systematic recording of nursing assessment according to Gordon's 11 Functional Health Patterns.">
			use = <"Used during nursing assessment phase.">
			keywords = <"Gordon", "functional health patterns", "nursing assessment">
			copyright = <"© 2026 Sensire">
		>
	>
	lifecycle_state = <"in_development">

definition
	OBSERVATION[at0000] matches {	-- Gezondheidspatronen van Gordon Anamnese
		data matches {
			HISTORY[at0001] matches {	-- Event Series
