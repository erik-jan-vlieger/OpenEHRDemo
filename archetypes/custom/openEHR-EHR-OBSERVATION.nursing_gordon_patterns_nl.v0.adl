					description = <"Observaties voeding en stofwisseling.">
				>
				["at0010"] = <
					text = <"3. Uitscheidingspatroon">
					description = <"Darm- en blaasfunctie, continentie, transpiratie.">
				>
				["at0011"] = <
					text = <"Afwijking of risico aanwezig">
					description = <"Aandachtspunt aanwezig.">
				>
				["at0012"] = <
					text = <"Bevindingen en toelichting">
					description = <"Observaties uitscheiding.">
				>
				["at0013"] = <
					text = <"4. Activiteiten- en bewegingspatroon">
					description = <"Mobiliteit, ADL-zelfstandigheid, energie, vrije tijd en conditie.">
				>
				["at0014"] = <
					text = <"Afwijking of risico aanwezig">
