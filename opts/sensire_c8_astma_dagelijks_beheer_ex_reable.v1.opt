    <archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><template_id><value>sensire_c8_astma_dagelijks_beheer_ex_reable</value></template_id><term_definitions code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></term_definitions><term_definitions code="id1"><items id="description">Cliënt met gediagnosticeerd of vermoed astma die wordt beoordeeld voor dagelijks beheer, inhalatietechniek of bij een acute toename van dyspneuklachten.</items><items id="text">C8 - Astma — dagelijks beheer + exacerbatie-actieplan (ReAble)</items></term_definitions><term_definitions code="id2"><items id="description">Primaire aandoening of indicatie van het zorgpad.</items><items id="text">Probleem of Diagnose</items></term_definitions><term_definitions code="id3"><items id="description">Doel van de cliënt in eigen woorden en gewenste uitkomsten.</items><items id="text">Persoonlijk Doel &amp; Streefdoelen</items></term_definitions><term_definitions code="id4"><items id="description">Wensen van de client, bereidheid tot afspraken en klinische observaties.</items><items id="text">Anamnese &amp; Wil-vraag</items></term_definitions><term_definitions code="id5"><items id="description">Voorlichting, educatie en vaardigheidstraining rond zelfzorg.</items><items id="text">Instructie &amp; Zelfmanagement Coaching</items></term_definitions><term_definitions code="id6"><items id="description">Gezamenlijke afspraken over zelfmonitoring, frequentie en actieplan.</items><items id="text">Afspraken &amp; Zelfmonitoring Plan</items></term_definitions><term_definitions code="id7"><items id="description">Verpleegkundige acties, ondersteuning en rol-verdeling.</items><items id="text">Interventie / Handeling</items></term_definitions><term_definitions code="id8"><items id="description">Overleg of order aan arts of specialist bij verslechtering.</items><items id="text">Escalatie / Verwijzing</items></term_definitions><term_definitions code="id9"><items id="description">Eindevaluatie en zelfstandigheidsstatus van de cliënt.</items><items id="text">Klinische Synopsis &amp; Kunnen-Status</items></term_definitions></definition>
