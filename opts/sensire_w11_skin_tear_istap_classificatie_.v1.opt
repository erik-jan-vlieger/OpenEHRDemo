    <terminology archetype_id="openEHR-EHR-COMPOSITION.sensire_w11_skin_tear_istap_classificatie_.v1.0.0" is_differential="false" original_language="nl">
        <concept_code>id1</concept_code>
        <term_definitions language="de">
