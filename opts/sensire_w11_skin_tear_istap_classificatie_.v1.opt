                <text>Dificultades del procedimiento</text>
            </items>
            <items id="at0070">
                <description>El motivo, clínico o relacionado con el proceso, del procedimiento.</description>
                <text>Indicación</text>
            </items>
            <items id="at0071">
                <description>Evaluación global del impacto o relevancia de un procedimiento o su resultado para un paciente concreto.</description>
                <text>Impacto</text>
            </items>
            <items id="at0072">
                <description>*The intended outcome of the procedure. (en)</description>
                <text>*Intent (en)</text>
            </items>
            <items id="at0073">
                <description>*The date or datetime when the entire procedure, or the first component of a multicomponent procedure, was first started. (en)</description>
                <text>*Start datetime (en)</text>
            </items>
            <items id="at0074">
                <description>*The duration of time between the start of the most recent pathway step for this procedure and the start of the current pathway step. (en)</description>
                <text>*Pathway step duration (en)</text>
            </items>
            <items id="at0000">
                <description>Actividad clínica llevada a cabo con fines de cribado, investigación, diagnóstico, curativos, terapéuticos, de evaluación o paliativos.</description>
                <text>Procedimiento</text>
            </items>
