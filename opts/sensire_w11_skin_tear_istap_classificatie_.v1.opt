            </items>
            <items id="at0065">
                <description>Identifiering av specifik metod eller teknik för åtgärden.</description>
                <text>Metod</text>
            </items>
            <items id="at0066">
                <description>Det datum eller datum/tid som åtgärden är planerad att utföras.</description>
                <text>Planerat datum/tid</text>
            </items>
            <items id="at0067">
                <description>Typ av åtgärd</description>
                <text>Åtgärdstyp</text>
            </items>
            <items id="at0068">
                <description>Åtgärden är påbörjad.</description>
                <text>Åtgärd påbörjad</text>
            </items>
            <items id="at0069">
                <description>Svårigheter eller problem som uppstår under genomförandet av åtgärden.</description>
                <text>Svårigheter med åtgärd</text>
            </items>
            <items id="at0070">
                <description>Den kliniska eller processrelaterade orsaken till åtgärden.</description>
                <text>Indikation</text>
            </items>
            <items id="at0071">
                <description>Bedömning av vilken påverkan en åtgärd eller dess resultat har på den enskilda patienten.</description>
                <text>Påverkan</text>
            </items>
            <items id="at0072">
                <description>Det avsedda resultatet av åtgärden.</description>
                <text>Avsikt</text>
            </items>
            <items id="at0073">
                <description>Det datum, eller datum och tid, då hela åtgärden påbörjades eller den första delen av en åtgärd som består av flera delmoment.</description>
                <text>Start datum/tid</text>
            </items>
            <items id="at0074">
                <description>Tidsperioden mellan starten av det senast registrerade processteget för denna åtgärd och starten av det aktuella processteget.</description>
                <text>Duration för processteg</text>
            </items>
            <items id="at0000">
                <description>En klinisk aktivitet utförd för screening-, undersökande, diagnostiska, botande, terapeutiska, utvärderande eller palliativa ändamål.</description>
                <text>Åtgärd</text>
            </items>
