    <component_terminologies archetype_id="openEHR-EHR-INSTRUCTION.service_request.v1" original_language="en">
        <concept_code>at0000</concept_code>
        <term_definitions language="de">
            <items id="at0000">
                <description>Antrag auf eine gesundheitsbezogene Dienstleistung oder Aktivität, die von einem Kliniker, einer Klinik oder einer Einrichtung erbracht werden soll.</description>
                <text>Dienstleistung</text>
            </items>
            <items id="at0001">
                <description>Aktuelle Aktivität</description>
                <text>Aktuelle Aktivität</text>
            </items>
            <items id="at0008">
                <description>@ internal @</description>
                <text>Tree</text>
            </items>
            <items id="at0009">
                <description>@ internal @</description>
                <text>Tree</text>
            </items>
            <items id="at0010">
                <description>Lokale Auftrags-ID des anfordernden/einsendenden Systems.</description>
                <text>Auftrags-ID des anfordernden/einsendenden Systems</text>
            </items>
            <items id="at0011">
                <description>Lokale Auftrags-ID, die der Anforderung durch den Kliniker oder die Organisation, die die Leistungsanforderung erhält, zugewiesen wurde.</description>
                <text>Auftrags-ID (Empfänger)</text>
            </items>
            <items id="at0040">
                <description>Datum/Uhrzeit oder Beschreibung des Zeitplans für die Erbringung der angeforderten Dienstleistung(en).</description>
                <text>Anstehende Dienstleistung</text>
            </items>
            <items id="at0062">
                <description>Das spezifische Problem, das Aufmerksamkeit erfordert, oder die klinische Frage, die untersucht werden muss.</description>
                <text>Grund für die Anforderung</text>
            </items>
            <items id="at0064">
                <description>Narrative Beschreibung des Problems oder der klinischen Frage, die gelöst werden muss.</description>
                <text>Beschreibung des Grundes</text>
            </items>
            <items id="at0065">
                <description>Beschreibung des beabsichtigten Ergebnisses der Anfrage.</description>
                <text>Intention</text>
            </items>
            <items id="at0068">
                <description>Dringlichkeit der Anforderung der Dienstleistung.</description>
                <text>Dringlichkeit</text>
            </items>
            <items id="at0076">
                <description>Ergänzende Informationen werden auf Anfrage zur Verfügung gestellt.</description>
                <text>Ergänzende Informationen</text>
            </items>
            <items id="at0078">
                <description>Beschreibung der Zusatzinformationen.</description>
                <text>Beschreibung der Informationen</text>
            </items>
            <items id="at0112">
                <description>Zusätzliche Informationen zur Erfassung lokaler Inhalte oder Anpassung an andere Referenzmodelle / Formalismen.</description>
                <text>Erweiterung</text>
            </items>
            <items id="at0116">
                <description>Sprach-, Transport- oder andere persönliche Anforderungen, um die Beteiligung oder Teilnahme des Patienten an der Erbringung der Dienstleistung zu unterstützen.</description>
                <text>Anforderungen an Patienten</text>
            </items>
            <items id="at0121">
                <description>Der Name der angeforderten Dienstleistung(en).</description>
                <text>Name der Dienstleistung</text>
            </items>
            <items id="at0127">
                <description>Der Status des Zustellungsantrags, wie vom Antragsteller angegeben.</description>
                <text>Status der Anfrage</text>
            </items>
            <items id="at0128">
                <description>Details über weitere Kliniker, Organisationen oder Einrichtungen, die Kopien aller Mitteilungen benötigen.</description>
                <text>Verteilerliste</text>
            </items>
            <items id="at0132">
                <description>Zusätzliche Details über die angeforderte Dienstleistung.</description>
                <text>Spezifische Details</text>
            </items>
            <items id="at0135">
                <description>Narrative Beschreibung der gewünschten Dienstleistung.</description>
                <text>Beschreibung</text>
            </items>
            <items id="at0136">
                <description>Die Anforderung erfordert sofortige Behandlung.</description>
                <text>Notfall</text>
            </items>
            <items id="at0137">
                <description>Die Anforderung erfordert eine prioritäre Behandlung.</description>
                <text>Dringend</text>
            </items>
            <items id="at0138">
                <description>Die Anforderung erfordert keine priorisierte Planung.</description>
                <text>Routine</text>
            </items>
            <items id="at0141">
                <description>Details über den Kliniker oder die Abteilung, die die Dienstleistung anfordert.</description>
                <text>Einsender</text>
            </items>
            <items id="at0142">
                <description>Details über den Kliniker oder die Abteilung, die die Dienstleistung erhält.</description>
                <text>Empfänger</text>
            </items>
            <items id="at0148">
                <description>Kategorie der beantragten Dienstleistung.</description>
                <text>Art der Dienstleistung</text>
            </items>
            <items id="at0149">
                <description>Digitales Dokument, Bild, Video oder Diagramm als zusätzliche Information zur Unterstützung oder Information der Anforderung.</description>
                <text>Unterstützende Informationen</text>
            </items>
            <items id="at0150">
                <description>Weitere Informationen über die Dienstanforderung, welche bisher nicht in den anderen Feldern erfasst wurden.</description>
                <text>Kommentar</text>
            </items>
            <items id="at0151">
                <description>Einzelheiten über eine komplexe Dienstanforderung, die eine Abfolge von Zeitangaben erfordert.</description>
                <text>Komplexe Zeitplanung</text>
            </items>
            <items id="at0152">
                <description>Das Symptom, das Zeichen oder die Diagnose, die die angeforderte Leistung erforderlich macht.</description>
                <text>Klinische Indikation</text>
            </items>
            <items id="at0153">
                <description>Zusätzliche Details und Anweisungen darüber, wie die Dienstleistungen zu erbringen sind.</description>
                <text>Auftragsdetail</text>
            </items>
            <items id="at0154">
                <description>Beschreibende Information über die Person und ihre Situation, die einen relevanten Kontext für den Antrag liefern.</description>
                <text>Klinischer Kontext</text>
            </items>
            <items id="at0155">
                <description>Angaben über die benannte Kontaktperson oder Organisation und die bevorzugte Kontaktart für dringende oder notfallbedingte Benachrichtigungen im Zusammenhang mit diesem Antrag.</description>
                <text>Notfallkontakt</text>
            </items>
            <items id="at0156">
                <description>Eine Empfehlung des Anforderers an den Empfänger über die Art der Bezahlung der Dienstleistung.</description>
                <text>Abrechnungshinweise</text>
            </items>
            <items id="at0157">
                <description>Angaben zu der Person oder Organisation, die die Verantwortung für die Bezahlung der Dienstleistung übernehmen wird.</description>
                <text>Zahlungspflichtiger</text>
            </items>
            <items id="at0158">
                <description>Mitteilung des Antragstellers an den Empfänger über die Berechtigung der Person, die beantragte Dienstleistung in Anspruch zu nehmen.</description>
                <text>Genehmigungsleitlinie</text>
            </items>
            <items id="at0000">
                <description>Antrag auf eine gesundheitsbezogene Dienstleistung oder Aktivität, die von einem Kliniker, einer Klinik oder einer Einrichtung erbracht werden soll.</description>
                <text>Dienstleistung</text>
            </items>
        </term_definitions>
        <term_definitions language="pt-pt">
            <items id="at0000">
                <description>Pedido de um serviço ou atividade relacionada com a saúde a prestar por um médico, organização ou agência.</description>
                <text>Pedido de serviço</text>
            </items>
            <items id="at0001">
                <description>Atividade atual.</description>
                <text>Atividade atual</text>
            </items>
            <items id="at0008">
                <description>@ internal @</description>
                <text>Tree</text>
            </items>
            <items id="at0009">
                <description>@ internal @</description>
                <text>Tree</text>
            </items>
            <items id="at0010">
                <description>O identificador local atribuído pelo sistema clínico requerente.</description>
                <text>Identificador do requerente do pedido</text>
            </items>
            <items id="at0011">
                <description>O identificador local atribuído ao pedido pelo médico ou organização que recebe o pedido de serviço.</description>
                <text>Identificador do recetor do pedido</text>
            </items>
            <items id="at0040">
                <description>A data/hora ou descrição sobre o momento da prestação do(s) serviço(s) solicitado(s).</description>
                <text>Momento do serviço</text>
            </items>
            <items id="at0062">
                <description>O problema específico que requer atenção ou a questão clínica que requer investigação.</description>
                <text>Motivo do pedido</text>
            </items>
            <items id="at0064">
                <description>Descrição narrativa sobre o problema ou dúvida clínica que necessita de ser resolvida.</description>
                <text>Descrição do motivo</text>
            </items>
            <items id="at0065">
                <description>Descrição do resultado pretendido do pedido.</description>
                <text>Intenção</text>
            </items>
            <items id="at0068">
                <description>Urgência da solicitação de atendimento.</description>
                <text>Urgência</text>
            </items>
            <items id="at0076">
                <description>Informações complementares estarão disponíveis mediante pedido.</description>
                <text>Informação suplementar</text>
            </items>
            <items id="at0078">
                <description>Descrição das informações complementares.</description>
                <text>Descrição da informação</text>
            </items>
            <items id="at0112">
                <description>Informação adicional necessária para ampliar o modelo com conteúdo local ou para o alinhar com outros modelos de referência ou formalismos.</description>
                <text>Extensão</text>
            </items>
            <items id="at0116">
                <description>Língua, transporte ou outros requisitos pessoais para apoiar a comparência ou participação do doente na prestação do serviço.</description>
                <text>Requisitos do paciente</text>
            </items>
            <items id="at0121">
                <description>O(s) nome(s) do(s) serviço(s) solicitado(s).</description>
                <text>Nome do serviço</text>
            </items>
            <items id="at0127">
                <description>O estado do pedido de serviço conforme indicado pelo requerente.</description>
                <text>Estado do pedido</text>
            </items>
            <items id="at0128">
                <description>Detalhes de médicos, organizações ou agências adicionais que exijam cópias de qualquer comunicação.</description>
                <text>Lista de distribuição</text>
            </items>
            <items id="at0132">
                <description>Detalhes adicionais sobre o serviço solicitado.</description>
                <text>Detalhes específicos</text>
            </items>
            <items id="at0135">
                <description>Descrição narrativa sobre o serviço solicitado.</description>
                <text>Descrição</text>
            </items>
            <items id="at0136">
                <description>O pedido requer atenção imediata.</description>
                <text>Emergência</text>
            </items>
            <items id="at0137">
                <description>O pedido requer atenção prioritária.</description>
                <text>O pedido requer atenção imediata.</text>
            </items>
            <items id="at0138">
                <description>O pedido não requer agendamento prioritário.</description>
                <text>Rotina</text>
            </items>
            <items id="at0141">
                <description>Detalhes sobre o médico ou organização que solicita o serviço.</description>
                <text>Requerente</text>
            </items>
            <items id="at0142">
                <description>Detalhes sobre o médico ou organização que recebe o pedido de serviço.</description>
                <text>Recetor</text>
            </items>
            <items id="at0148">
                <description>Categoria do serviço solicitado.</description>
                <text>Tipo de serviço</text>
            </items>
            <items id="at0149">
                <description>Documento digital, imagem, vídeo ou diagrama fornecido como informação adicional para apoiar ou informar o pedido.</description>
                <text>Informações de apoio</text>
            </items>
            <items id="at0150">
                <description>Narrativa adicional sobre o pedido de serviço não capturada noutros campos.</description>
                <text>Comentário</text>
            </items>
            <items id="at0151">
                <description>Detalhes sobre um pedido de serviço complexo que exige uma sequência de horários.</description>
                <text>Tempo complexo</text>
            </items>
            <items id="at0152">
                <description>O sintoma, sinal ou diagnóstico que necessita do serviço solicitado.</description>
                <text>Indicação clínica</text>
            </items>
            <items id="at0153">
                <description>Detalhes e instruções adicionais sobre como os serviços serão prestados.</description>
                <text>Detalhe do pedido</text>
            </items>
            <items id="at0154">
                <description>Informação narrativa sobre o indivíduo e a sua situação, fornecendo contexto relevante para a solicitação.</description>
                <text>Contexto clínico</text>
            </items>
            <items id="at0155">
                <description>Detalhes sobre a pessoa ou organização de contacto designada e modo de contacto preferencial para notificações urgentes ou de emergência relacionadas com este pedido.</description>
                <text>Contacto urgente</text>
            </items>
            <items id="at0156">
                <description>Uma recomendação do requerente ao destinatário sobre a forma de pagamento do serviço.</description>
                <text>Orientação de faturação</text>
            </items>
            <items id="at0157">
                <description>Detalhes sobre o indivíduo ou organização que assumirá a responsabilidade pelo pagamento do serviço.</description>
                <text>Responsável pelo pagamento</text>
            </items>
            <items id="at0158">
                <description>Aconselhamento do requerente ao destinatário sobre a elegibilidade do indivíduo para o serviço solicitado.</description>
                <text>Orientação de elegibilidade</text>
            </items>
            <items id="at0000">
                <description>Pedido de um serviço ou atividade relacionada com a saúde a prestar por um médico, organização ou agência.</description>
                <text>Pedido de serviço</text>
            </items>
        </term_definitions>
        <term_definitions language="sv">
            <items id="at0000">
                <description>Förfrågan om en hälso- och sjukvårdsrelaterad tjänst eller aktivitet som behöver genomföras av en kliniker, organisation eller myndighet.</description>
