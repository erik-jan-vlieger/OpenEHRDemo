  <ontology>
    <term_definitions language="nl">
      <items code="at0000">
        <items id="text">C1 — Hartfalen — vochtretentie &amp; gewichtstoename</items>
        <items id="description">Scope wijkverpleegkundige: het regelmatig monitoren van gewicht en overvullingsverschijnselen, instrueren van zelfmanagement/flexibel diureticumbeleid, en tijdig escaleren bij verslechtering. De medicatiewijziging zelf wordt door de arts geïnitieerd of vooraf vastgelegd in een individueel behandelplan.</items>
      </items>
    </term_definitions>
  </ontology>
