                <archetype_id><value>openEHR-EHR-EVALUATION.goal.v1</value></archetype_id><term_definitions code="at0000"><items id="description">Een voor de zorgontvanger gewenste uitkomst op het gebied van gezondheid of welbevinden.</items><items id="text">Doel</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="description">De naam van het gewenste gezondheidsdoel.</items><items id="text">Naam van het doel</items></term_definitions><term_definitions code="at0003"><items id="description">De gewenste of voorgestelde datum voor het het bereiken van het doel.</items><items id="text">Voorgestelde datum van het doel</items></term_definitions><term_definitions code="at0004"><items id="description">De werkelijke datum waarop het doel werd behaald of opgegeven.</items><items id="text">Einddatum van het doel</items></term_definitions><term_definitions code="at0005"><items id="description">Gegevens over het beoogde doel/de doelstelling/de streefwaarde.</items><items id="text">Doelstelling</items></term_definitions><term_definitions code="at0006"><items id="description">Het archetype en pad naar de node voor de data van de doelstelling.</items><items id="text">Pad van de doelstelling</items></term_definitions><term_definitions code="at0007"><items id="description">De beoogde doelstelling.</items><items id="text">Doelstelling</items></term_definitions><term_definitions code="at0008"><items id="description">De gewenste of voorgestelde datum voor het behalen van de doelstelling.&#13;
</items><items id="text">Voorgestelde doelstellingsdatum</items></term_definitions><term_definitions code="at0009"><items id="description">De daadwerkelijke datum waarop de doelstelling werd behaald of opgegeven.</items><items id="text">Einddatum van de doelstelling</items></term_definitions><term_definitions code="at0010"><items id="description">Naam van het probleem of de diagnose die aangepakt wordt door het behalen van dit doel.</items><items id="text">Indicatie</items></term_definitions><term_definitions code="at0011"><items id="description">Benoemen van de beoogde doelstelling.</items><items id="text">Naam van de doelstelling</items></term_definitions><term_definitions code="at0012"><items id="description">Een verhalende beschrijving van het doel, inclusief te behalen doelstellingen wanneer relevant.</items><items id="text">Doel beschrijving</items></term_definitions><term_definitions code="at0013"><items id="description">Enkel woord, uitdrukking of korte beschrijving die het behaalde resultaat weergeeft van het doel.</items><items id="text">Doel uitkomst</items></term_definitions><term_definitions code="at0015"><items id="description">Het voorgestelde doel is behaald.</items><items id="text">Behaald</items></term_definitions><term_definitions code="at0016"><items id="description">Het voorgestelde doel is deel behaald.</items><items id="text">Deel behaald</items></term_definitions><term_definitions code="at0017"><items id="description">Het voorgestelde doel is niet behaald of is opgegeven.</items><items id="text">Niet behaald</items></term_definitions><term_definitions code="at0018"><items id="description">Enkel woord, uitdrukking of korte beschrijving die het werkelijk behaalde resultaat weergeeft van de doelstelling.</items><items id="text">Doelstellingsresultaat</items></term_definitions><term_definitions code="at0019"><items id="description">De doelstelling werd gerealiseerd.</items><items id="text">Behaald</items></term_definitions><term_definitions code="at0020"><items id="description">De doelstelling werd gedeeltelijk behaald.</items><items id="text">Gedeeltelijk behaald</items></term_definitions><term_definitions code="at0021"><items id="description">De doelstelling werd niet behaald of werd opgegeven.</items><items id="text">Niet behaald</items></term_definitions><term_definitions code="at0022"><items id="description">Extra toelichting over het doel die niet past binnen andere velden.</items><items id="text">Opmerking doel</items></term_definitions><term_definitions code="at0023"><items id="description">Extra beschrijving over de doelstelling die niet past binnen andere velden.</items><items id="text">Doelstelling opmerking</items></term_definitions><term_definitions code="at0024"><items id="description">Verhalende beschrijving van de beoogde doelstelling.</items><items id="text">Beschrijving van de doelstelling</items></term_definitions><term_definitions code="at0025"><items id="description">De verwachte of voorgestelde datum waarop begonnen wordt te werken richting het doel.</items><items id="text">Doel startdatum</items></term_definitions><term_definitions code="at0026"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0027"><items id="description">Extra informatie vereist bij het vastleggen van lokale informatie of voor het verbinden met andere referentie modellen/formalismen.</items><items id="text">Uitbreiding</items></term_definitions><term_definitions code="at0028"><items id="description">Gegevens over de bereidheid tot gedragsverandering om het gewenste doel te behalen.</items><items id="text">Bereidheid tot verandering</items></term_definitions><term_definitions code="at0029"><items id="description">De datum waarop het doel het laatst werd bijgewerkt.</items><items id="text">Laatst bijgewerkt</items></term_definitions><term_definitions code="at0000"><items id="description">Een voor de zorgontvanger gewenste uitkomst op het gebied van gezondheid of welbevinden.</items><items id="text">Doel</items></term_definitions></children>
