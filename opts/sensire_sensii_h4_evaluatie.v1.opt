    <archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><template_id><value>sensire_sensii_h4_evaluatie</value></template_id><term_definitions code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></term_definitions><term_definitions code="id1"><items id="description">Periodieke zorgplan- en doelenevaluatie binnen het verpleegkundig proces.</items><items id="text">Sensii Hoofdstuk 4: Evaluatie van zorg</items></term_definitions><term_definitions code="id2"><items id="description">Herbeoordeling van KBS scores (Kennis, Gedrag, Status) ten opzichte van streefdoelen.</items><items id="text">Evaluatie Omaha Aandachtsgebieden</items></term_definitions><term_definitions code="id3"><items id="description">Evaluatie van groei in eigen regie en zelfredzaamheid.</items><items id="text">Evaluatie Regietrede</items></term_definitions><term_definitions code="id4"><items id="description">Herhaalde meting van de Groningen Frailty Indicator.</items><items id="text">Hermeting GFI Kwetsbaarheid</items></term_definitions><term_definitions code="id5"><items id="description">Herziening van persoonlijke doelen en cliënttevredenheid.</items><items id="text">Evaluatie Behoeften en Wensen</items></term_definitions><term_definitions code="id6"><items id="description">Verpleegkundige eindconclusie over continuering, bijstelling of afsluiting van de zorg.</items><items id="text">Evaluatiesynthese en Vervolgbesluit</items></term_definitions></definition>
    </template>