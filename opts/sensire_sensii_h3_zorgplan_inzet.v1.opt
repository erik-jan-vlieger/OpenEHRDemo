    <archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><template_id><value>sensire_sensii_h3_zorgplan_inzet</value></template_id><term_definitions code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></term_definitions><term_definitions code="id1"><items id="description">Zorgplanning, Omaha interventies, KBS doelen en inzet van zorg.</items><items id="text">Sensii Hoofdstuk 3: Wat we gaan doen &amp; Zorgplan</items></term_definitions><term_definitions code="id2"><items id="description">Actievlakken (adviseren, behandelen, bewaken, casemanagement), streefscores KBS en interventies.</items><items id="text">Omaha Zorgplan per Aandachtsgebied</items></term_definitions><term_definitions code="id3"><items id="description">Aanvraag en planning van specifieke zorgactiviteiten.</items><items id="text">Zorgplaninstructies</items></term_definitions><term_definitions code="id4"><items id="description">Status van opstart en operationele uitvoering van het zorgplan.</items><items id="text">Zorgplanuitvoering</items></term_definitions><term_definitions code="id5"><items id="description">Wettelijk kader (Zvw/Wlz/Wmo), leveringsvorm (ZIN/PGB/VPT/MPT) en geïndiceerde zorgduur.</items><items id="text">Financiering &amp; Leveringsvorm</items></term_definitions><term_definitions code="id6"><items id="description">Verpleegkundige educatie, zelfmanagement-instructie en leefregels.</items><items id="text">Voorlichting en Begeleiding</items></term_definitions><term_definitions code="id7"><items id="description">Klinische verantwoording en afspraken met de cliënt en mantelzorg.</items><items id="text">Toelichting Zorgplan</items></term_definitions></definition>
