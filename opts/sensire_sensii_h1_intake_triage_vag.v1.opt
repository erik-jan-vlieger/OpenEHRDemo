    <archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><template_id><value>sensire_sensii_h1_intake_triage_vag</value></template_id><term_definitions code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></term_definitions><term_definitions code="id1"><items id="description">Intake, triage en verpleegkundig adviesgesprek (VAG).</items><items id="text">Sensii Hoofdstuk 1: Wie deze cliënt is</items></term_definitions><term_definitions code="id2"><items id="description">Beoordeling passendheid, urgentie en type zorgrelatie.</items><items id="text">Wijkverpleegkundige Triage</items></term_definitions><term_definitions code="id3"><items id="description">Hulpvraag, persoonlijke kracht, netwerkkracht en draagkracht vs lasten.</items><items id="text">Verpleegkundig Adviesgesprek (VAG)</items></term_definitions><term_definitions code="id4"><items id="description">Inschatting van eigen regie, start Kennis en Gedrag scores.</items><items id="text">Start Regietrede &amp; KBS</items></term_definitions><term_definitions code="id5"><items id="description">Levensloop, context en wat voor de cliënt van betekenis is (Langer thuis route).</items><items id="text">Levensverhaal &amp; Verdieping</items></term_definitions><term_definitions code="id6"><items id="description">Persoonlijke doelen en streefwaarden van de cliënt.</items><items id="text">Behoeften en Wensen</items></term_definitions><term_definitions code="id7"><items id="description">Verpleegkundige synthese en advies voor de anamnesefase.</items><items id="text">Conclusie VAG</items></term_definitions></definition>
    </template>