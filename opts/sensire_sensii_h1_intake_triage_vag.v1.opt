</items><items id="text">Erweiterung</items></term_definitions><term_definitions code="at0000"><items id="description">Zusammenfassung oder Übersicht einer Patientengeschichte, speziell aus der Sicht eines Gesundheitsdienstleisters, evtl. mit dazugehörigen Interpretationen.</items><items id="text">Klinische Synopsis</items></term_definitions></children>
