                <archetype_id><value>openEHR-EHR-EVALUATION.nursing_vag_nl.v0</value></archetype_id><term_definitions code="at0000"><items id="description">Verkenning van hulpvraag, eigen regie, persoonlijke kracht en netwerk.</items><items id="text">Verpleegkundig Adviesgesprek (VAG)</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Boom</items></term_definitions><term_definitions code="at0002"><items id="description">De oorspronkelijke hulpvraag in de woorden van de cliënt/aanvrager.</items><items id="text">Hulpvraag van de cliënt</items></term_definitions><term_definitions code="at0003"><items id="description">Wat wil de cliënt bereiken of behouden?</items><items id="text">Gewenste situatie en doelen van de cliënt</items></term_definitions><term_definitions code="at0004"><items id="description">Inventarisatie van fysieke, mentale en cognitieve vermogens.</items><items id="text">Persoonlijke kracht</items></term_definitions><term_definitions code="at0005"><items id="description">Wat kan de cliënt zelfstandig of met hulpmiddelen?</items><items id="text">Fysieke mogelijkheden en zelfredzaamheid</items></term_definitions><term_definitions code="at0006"><items id="description">Gezindheid, wilskracht en motivatie tot herstel of zelfmanagement.</items><items id="text">Mentale veerkracht en motivatie</items></term_definitions><term_definitions code="at0007"><items id="description">Vermogen om nieuwe handelingen of routines aan te leren.</items><items id="text">Vaardigheden en leervermogen</items></term_definitions><term_definitions code="at0008"><items id="description">Kracht en draagkracht van het sociale netwerk.</items><items id="text">Netwerkkracht en mantelzorg</items></term_definitions><term_definitions code="at0009"><items id="description">Mate waarin mantelzorg en netwerk beschikbaar zijn.</items><items id="text">Aanwezigheid informeel netwerk</items></term_definitions><term_definitions code="at0010"><items id="description">Netwerk levert substantiële ondersteuning.</items><items id="text">Sterk en actief betrokken netwerk</items></term_definitions><term_definitions code="at0011"><items id="description">Slechts enkele personen of beperkte inzetbaarheid.</items><items id="text">Beperkt netwerk aanwezig</items></term_definitions><term_definitions code="at0012"><items id="description">Sociaal geïsoleerd of afwezig netwerk.</items><items id="text">Geen of nauwelijks sociaal netwerk</items></term_definitions><term_definitions code="at0013"><items id="description">Draaglast en risico op overbelasting van de belangrijkste mantelzorger.</items><items id="text">Belasting mantelzorger</items></term_definitions><term_definitions code="at0014"><items id="description">Geen overbelasting.</items><items id="text">Goed vol te houden (niet overbelast)</items></term_definitions><term_definitions code="at0015"><items id="description">Signalen van fysieke of mentale vermoeidheid.</items><items id="text">Dreigende overbelasting</items></term_definitions><term_definitions code="at0016"><items id="description">Overbelast; directe ontlasting vereist.</items><items id="text">Ernstig overbelast (respijtzorg nodig)</items></term_definitions><term_definitions code="at0017"><items id="description">Beschrijving van wie wat doet in het netwerk.</items><items id="text">Toelichting mantelzorg en netwerk</items></term_definitions><term_definitions code="at0018"><items id="description">Analyse van problemen en belemmerende factoren.</items><items id="text">Ordening van lasten</items></term_definitions><term_definitions code="at0019"><items id="description">Wat belemmert de cliënt het meest in het dagelijks leven?</items><items id="text">Primaire belemmeringen en lasten</items></term_definitions><term_definitions code="at0020"><items id="description">Klinische complexiteit van de zorgsituatie.</items><items id="text">Mate van complexiteit</items></term_definitions><term_definitions code="at0021"><items id="description">Enkelvoudig, overzichtelijk.</items><items id="text">Laag-complex (enkelvoudige zorgvraag)</items></term_definitions><term_definitions code="at0022"><items id="description">Combinatie van factoren.</items><items id="text">Midden-complex (meervoudige problematiek)</items></term_definitions><term_definitions code="at0023"><items id="description">Complexe wisselwerking tussen somatiek, psyche en systeem.</items><items id="text">Hoog-complex (multiproblematiek / wankel evenwicht)</items></term_definitions><term_definitions code="at0024"><items id="description">Eindoordeel over regievermogen en noodzakelijke vervolgfocus.</items><items id="text">Conclusie Verpleegkundig Adviesgesprek</items></term_definitions><term_definitions code="at0025"><items id="description">Patronen van Gordon die specifiek moeten worden uitgevraagd.</items><items id="text">Advies voor Anamnese (aandachtspatronen)</items></term_definitions><term_definitions code="at0000"><items id="description">Verkenning van hulpvraag, eigen regie, persoonlijke kracht en netwerk.</items><items id="text">Verpleegkundig Adviesgesprek (VAG)</items></term_definitions></children>
