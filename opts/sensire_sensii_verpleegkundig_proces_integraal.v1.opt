    <archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id><template_id><value>sensire_sensii_verpleegkundig_proces_integraal</value></template_id><term_definitions code="at0000"><items id="description">Interactie, contact of zorggebeurtenis tussen een onderwerp van zorg en zorgverlener(s).</items><items id="text">Contact</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions><term_definitions code="at0002"><items id="description">*Additional information required to extend the model with local content or to align with other reference models or formalisms. (en)</items><items id="text">Extensie</items></term_definitions><term_definitions code="id1"><items id="description">Het integrale overkoepelende wijkverpleegkundige proces conform Sensii.</items><items id="text">Sensii Integraal Verpleegkundig Proces</items></term_definitions><term_definitions code="id2"><items id="description">Triage, passendheid en zorgrelatie.</items><items id="text">Wijkverpleegkundige Triage</items></term_definitions><term_definitions code="id3"><items id="description">Hulpvraag, persoonlijke kracht en mantelzorgdraagkracht.</items><items id="text">Verpleegkundig Adviesgesprek (VAG)</items></term_definitions><term_definitions code="id4"><items id="description">Systematische anamnese van functionele gezondheidspatronen.</items><items id="text">11 Gezondheidspatronen van Gordon</items></term_definitions><term_definitions code="id5"><items id="description">Groningen Frailty Indicator score.</items><items id="text">GFI Kwetsbaarheidsmeting</items></term_definitions><term_definitions code="id6"><items id="description">Eigen regie inschaling en KBS baseline.</items><items id="text">Regietrede en Zelfredzaamheid</items></term_definitions><term_definitions code="id7"><items id="description">Geprioriteerde aandachtsgebieden, doelen en actievlakken.</items><items id="text">Omaha Problemen &amp; Zorgplan</items></term_definitions><term_definitions code="id8"><items id="description">Aanvraag en specificatie van verpleegkundige zorgacties.</items><items id="text">Zorgplaninstructies</items></term_definitions><term_definitions code="id9"><items id="description">Operationele status van het zorgplan.</items><items id="text">Zorgplanuitvoering</items></term_definitions><term_definitions code="id10"><items id="description">Financieringskader (Zvw/Wlz/Wmo), uren/minuten en leveringsvorm.</items><items id="text">Financiering &amp; Leveringsvorm</items></term_definitions><term_definitions code="id11"><items id="description">Educatie, adviezen en instructie.</items><items id="text">Voorlichting &amp; Zelfzorgtraining</items></term_definitions><term_definitions code="id12"><items id="description">Persoonlijke doelen en streefwaarden.</items><items id="text">Cliëntdoelen en Wensen</items></term_definitions><term_definitions code="id13"><items id="description">Klinisch redeneren, synthese en periodieke evaluatie.</items><items id="text">Verpleegkundige Synthese &amp; Evaluatie</items></term_definitions></definition>
    </template>