                <archetype_id><value>openEHR-EHR-EVALUATION.triage_nursing_nl.v0</value></archetype_id><term_definitions code="at0000"><items id="description">Triagebeoordeling van de hulpvraag bij aanmelding.</items><items id="text">Wijkverpleegkundige Triage</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Boom</items></term_definitions><term_definitions code="at0002"><items id="description">Beoordeling of de vraag binnen het domein van wijkverpleging valt.</items><items id="text">Passendheid voor wijkverpleging</items></term_definitions><term_definitions code="at0003"><items id="description">Zorgvraag sluit aan bij aanspraak wijkverpleging (Zvw).</items><items id="text">Passend voor wijkverpleging</items></term_definitions><term_definitions code="at0004"><items id="description">Hulpvraag hoort thuis bij Wmo, welzijn of informele zorg.</items><items id="text">Niet passend (verwijzen naar voorliggend veld / sociaal domein)</items></term_definitions><term_definitions code="at0005"><items id="description">Zorgvraag vereist specialistische behandeling.</items><items id="text">Specialistische / ziekenhuiszorg vereist</items></term_definitions><term_definitions code="at0006"><items id="description">Acute situatie waar direct artscontact voor nodig is.</items><items id="text">Acute medische beoordeling vereist (huisarts/SEH)</items></term_definitions><term_definitions code="at0007"><items id="description">Snelheid waarmee zorgopstart noodzakelijk is.</items><items id="text">Urgentiecategorie</items></term_definitions><term_definitions code="at0008"><items id="description">Binnen gebruikelijke wachttijd/intakevenster.</items><items id="text">Planbare zorg (binnen reguliere termijn)</items></term_definitions><term_definitions code="at0009"><items id="description">Opstart binnen 1-2 dagen noodzakelijk.</items><items id="text">Dringende zorg (binnen 24-48 uur)</items></term_definitions><term_definitions code="at0010"><items id="description">Directe zorginzet vereist.</items><items id="text">Urgente zorg (direct / dezelfde dag)</items></term_definitions><term_definitions code="at0011"><items id="description">Type zorgroute (bijv. Langer Thuis route bij langdurige relatie).</items><items id="text">Verwachte zorgrelatie</items></term_definitions><term_definitions code="at0012"><items id="description">Opent de verdiepende routes zoals 'Leer de ander kennen' en 'Levensverhaal'.</items><items id="text">Intensieve langdurige relatie (Langer thuis route)</items></term_definitions><term_definitions code="at0013"><items id="description">Periodieke controle of waakvlamzorg.</items><items id="text">Laagfrequente langdurige relatie</items></term_definitions><term_definitions code="at0014"><items id="description">Tijdelijke zorg gericht op herstel van zelfstandigheid.</items><items id="text">Kortdurend / incidenteel hersteltraject</items></term_definitions><term_definitions code="at0015"><items id="description">Vervolgactie naar aanleiding van triage.</items><items id="text">Vervolgstap / Advies</items></term_definitions><term_definitions code="at0016"><items id="description">VAG plannen met cliënt en mantelzorg.</items><items id="text">Verpleegkundig adviesgesprek (VAG) inplannen</items></term_definitions><term_definitions code="at0017"><items id="description">Zorgpad direct opstarten.</items><items id="text">Directe intake en anamnese starten</items></term_definitions><term_definitions code="at0018"><items id="description">Terugkoppelen naar verwijzer.</items><items id="text">Warme overdracht / Terugkoppeling aanvrager</items></term_definitions><term_definitions code="at0019"><items id="description">Afsluiten na triage.</items><items id="text">Geen verdere actie wijkverpleging</items></term_definitions><term_definitions code="at0020"><items id="description">Nadere motivering van de verpleegkundige.</items><items id="text">Toelichting triagebesluit</items></term_definitions><term_definitions code="at0000"><items id="description">Triagebeoordeling van de hulpvraag bij aanmelding.</items><items id="text">Wijkverpleegkundige Triage</items></term_definitions></children>
