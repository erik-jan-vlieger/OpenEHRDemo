<template xmlns="http://schemas.openehr.org/v1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><language><terminology_id><value>ISO_639-1</value></terminology_id>
        <code_string>nl</code_string>
    </language><description>
        <original_author id="name">Erik-Jan Vlieger</original_author>
        <original_author id="organisation">Sensire</original_author>
        <original_author id="date">2026-08-18</original_author>
        <lifecycle_state>published</lifecycle_state><details>
            <language>
                <terminology_id><value>ISO_639-1</value></terminology_id>
                <code_string>nl</code_string>
            </language>
            <purpose>Integraal Sensii Verpleegkundig Proces — Overkoepelende openEHR compositie die het complete verpleegkundige proces omvat van Triage en Verpleegkundig Adviesgesprek (Hoofdstuk 1), via Gordon Anamnese, GFI en Omaha Probleemselectie (Hoofdstuk 2), tot Zorgplan, Actievlakken, Financiering en Evaluatie (Hoofdstuk 3 &amp; 4).</purpose>
            <keywords>Sensii</keywords>
            <keywords>integraal dossier</keywords>
            <keywords>verpleegkundig proces</keywords>
            <keywords>Omaha System</keywords>
            <keywords>Gordon patronen</keywords>
            <keywords>GFI</keywords>
            <keywords>regietrede</keywords>
            <keywords>zorgplan</keywords>
            <keywords>wijkverpleging</keywords>
            <use>Gebruik als holistisch primair dossierportret van de cliënt in de wijkverpleging, waarop speciële zorgpaden als modulaire modules aansluiten.</use>
        </details>
    </description>
