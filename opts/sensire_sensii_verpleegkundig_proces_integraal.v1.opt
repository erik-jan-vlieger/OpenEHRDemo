                <archetype_id><value>openEHR-EHR-EVALUATION.omaha_assessment_nl.v0</value></archetype_id><term_definitions code="at0000"><items id="description">Classificatie en zorgplanning conform het Omaha System.</items><items id="text">Omaha System Probleem en Zorgplanbeoordeling</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Boom</items></term_definitions><term_definitions code="at0002"><items id="description">Het overkoepelende Omaha domein.</items><items id="text">Omaha Domein</items></term_definitions><term_definitions code="at0003"><items id="description">Materiële en fysieke leefomgeving en veiligheid.</items><items id="text">1. Omgevingsdomein</items></term_definitions><term_definitions code="at0004"><items id="description">Patronen van gedrag, emoties, communicatie en relaties.</items><items id="text">2. Psychosociaal domein</items></term_definitions><term_definitions code="at0005"><items id="description">Functionele en lichamelijke processen en condities.</items><items id="text">3. Fysiologisch domein</items></term_definitions><term_definitions code="at0006"><items id="description">Gezondheidsgedrag, voeding, activiteit en therapietrouw.</items><items id="text">4. Gezondheidsgerelateerd gedragsdomein</items></term_definitions><term_definitions code="at0007"><items id="description">Het specifieke aandachtsgebied (bijv. Huid, Cognitie, Ademhaling, Medicatietrouw).</items><items id="text">Omaha Aandachtsgebied (Probleem)</items></term_definitions><term_definitions code="at0008"><items id="description">De prioriteitspositie in Sensii (maximaal 4 aandachtsgebieden tegelijk in actieve zorgplan).</items><items id="text">Prioriteitsslot</items></term_definitions><term_definitions code="at0009"><items id="description">Hoogste prioriteit in zorgplan.</items><items id="text">Prioriteit 1 (Eerste aandachtsgebied)</items></term_definitions><term_definitions code="at0010"><items id="description">Tweede prioriteit.</items><items id="text">Prioriteit 2 (Tweede aandachtsgebied)</items></term_definitions><term_definitions code="at0011"><items id="description">Derde prioriteit.</items><items id="text">Prioriteit 3 (Derde aandachtsgebied)</items></term_definitions><term_definitions code="at0012"><items id="description">Vierde prioriteit.</items><items id="text">Prioriteit 4 (Vierde aandachtsgebied)</items></term_definitions><term_definitions code="at0013"><items id="description">Karakteristiek van het Omaha probleem.</items><items id="text">Aard van het probleem</items></term_definitions><term_definitions code="at0014"><items id="description">Bestaand probleem met actuele symptomen.</items><items id="text">Actueel probleem</items></term_definitions><term_definitions code="at0015"><items id="description">Verhoogd risico, preventieve inzet nodig.</items><items id="text">Potentieel probleem / Risico</items></term_definitions><term_definitions code="at0016"><items id="description">Behoud en versterking van gezond functioneren.</items><items id="text">Gezondheidsbevordering</items></term_definitions><term_definitions code="at0017"><items id="description">Wie betreft het probleem.</items><items id="text">Doelgroep</items></term_definitions><term_definitions code="at0018"><items id="description">De individuele cliënt.</items><items id="text">Individu</items></term_definitions><term_definitions code="at0019"><items id="description">Het gezinssysteem of mantelzorgers.</items><items id="text">Gezin / Familie</items></term_definitions><term_definitions code="at0020"><items id="description">Grotere gemeenschap of woonomgeving.</items><items id="text">Gemeenschap</items></term_definitions><term_definitions code="at0021"><items id="description">Geselecteerde signalen/symptomen behorend bij het aandachtsgebied.</items><items id="text">Signalen en symptomen</items></term_definitions><term_definitions code="at0022"><items id="description">Metingen op de Omaha 5-puntsschalen voor Kennis, Gedrag en Status.</items><items id="text">KBS Scores (Kennis, Gedrag, Status)</items></term_definitions><term_definitions code="at0023"><items id="description">Mate van inzicht/kennis bij start (1=geen kennis .. 5=uitstekende kennis).</items><items id="text">Kennis baseline</items></term_definitions><term_definitions code="at0024"><items id="description">Doelscore voor kennis.</items><items id="text">Kennis streefscore</items></term_definitions><term_definitions code="at0025"><items id="description">Gemeten kennis bij evaluatie.</items><items id="text">Kennis evaluatiescore</items></term_definitions><term_definitions code="at0026"><items id="description">Mate van passend gezondheidsgedrag bij start (1=nooit passend .. 5=altijd passend).</items><items id="text">Gedrag baseline</items></term_definitions><term_definitions code="at0027"><items id="description">Doelscore voor gedrag.</items><items id="text">Gedrag streefscore</items></term_definitions><term_definitions code="at0028"><items id="description">Gemeten gedrag bij evaluatie.</items><items id="text">Gedrag evaluatiescore</items></term_definitions><term_definitions code="at0029"><items id="description">Mate van ernst/belemmering bij start (1=ernstige belemmering .. 5=geen belemmering).</items><items id="text">Status baseline</items></term_definitions><term_definitions code="at0030"><items id="description">Doelscore voor status.</items><items id="text">Status streefscore</items></term_definitions><term_definitions code="at0031"><items id="description">Gemeten status bij evaluatie.</items><items id="text">Status evaluatiescore</items></term_definitions><term_definitions code="at0032"><items id="description">Geplande en uitgevoerde acties behorend bij dit probleem.</items><items id="text">Omaha Interventies en Actievlakken</items></term_definitions><term_definitions code="at0033"><items id="description">Eén van de 4 Omaha actiesoorten.</items><items id="text">Soort actie</items></term_definitions><term_definitions code="at0034"><items id="description">Ondersteunen bij kennis, inzicht en zelfzorgvaardigheden.</items><items id="text">1. Adviseren, instrueren en begeleiden</items></term_definitions><term_definitions code="at0035"><items id="description">Directe verpleegtechnische of lichamelijke handelingen.</items><items id="text">2. Behandelen en procedures toepassen</items></term_definitions><term_definitions code="at0036"><items id="description">Systematisch observeren en controleren van gezondheidstoestand.</items><items id="text">3. Verpleegkundig monitoren en bewaken</items></term_definitions><term_definitions code="at0037"><items id="description">Afstemming met artsen, disciplines, mantelzorg en netwerk.</items><items id="text">4. Casemanagement en samenwerken</items></term_definitions><term_definitions code="at0038"><items id="description">Het specifieke actievlak (bijv. anatomie/fysiologie, medicatietoediening, wondzorg).</items><items id="text">Actievlak</items></term_definitions><term_definitions code="at0039"><items id="description">De op maat geformuleerde instructie of zorgafspraak.</items><items id="text">Cliënt-specifieke actiebeschrijving</items></term_definitions><term_definitions code="at0040"><items id="description">Bijv. 2x per dag, 7 dagen per week.</items><items id="text">Frequentie en tijdsduur</items></term_definitions><term_definitions code="at0041"><items id="description">Bijv. wijkverpleegkundige, verzorgende IG, cliënt zelf, mantelzorger.</items><items id="text">Uitvoerende discipline</items></term_definitions><term_definitions code="at0042"><items id="description">Verpleegkundige onderbouwing van de gekozen probleemfocus.</items><items id="text">Klinische toelichting en redeneerlijn</items></term_definitions><term_definitions code="at0000"><items id="description">Classificatie en zorgplanning conform het Omaha System.</items><items id="text">Omaha System Probleem en Zorgplanbeoordeling</items></term_definitions></children>
