                <archetype_id><value>openEHR-EHR-ADMIN_ENTRY.care_funding_delivery_nl.v0</value></archetype_id><term_definitions code="at0000"><items id="description">Vastlegging van de financieringsstroom en leveringsvoorwaarden.</items><items id="text">Zorgfinanciering en leveringsvorm</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Boom</items></term_definitions><term_definitions code="at0002"><items id="description">De wettelijke grondslag voor de zorgfinanciering.</items><items id="text">Wettelijk financieringskader</items></term_definitions><term_definitions code="at0003"><items id="description">Zorgverzekeringswet, geen eigen bijdrage.</items><items id="text">Zorgverzekeringswet (Zvw - Wijkverpleging)</items></term_definitions><term_definitions code="at0004"><items id="description">Langdurige intensieve zorg, eigen bijdrage CAK van toepassing.</items><items id="text">Wet langdurige zorg (Wlz)</items></term_definitions><term_definitions code="at0005"><items id="description">Gemeentelijke ondersteuning/begeleiding.</items><items id="text">Wet maatschappelijke ondersteuning (Wmo)</items></term_definitions><term_definitions code="at0006"><items id="description">Zorg voor jeugdigen onder 18 jaar.</items><items id="text">Jeugdwet</items></term_definitions><term_definitions code="at0007"><items id="description">Door cliënt zelf gefinancierd.</items><items id="text">Particulier / Zelfbekostigd</items></term_definitions><term_definitions code="at0008"><items id="description">De wijze waarop de zorg geleverd en gecontracteerd wordt.</items><items id="text">Leveringsvorm</items></term_definitions><term_definitions code="at0009"><items id="description">Directe levering door de gecontracteerde zorgaanbieder.</items><items id="text">Zorg in Natura (ZIN)</items></term_definitions><term_definitions code="at0010"><items id="description">Budget waarmee de cliënt zelf zorg inkoopt.</items><items id="text">Persoonsgebonden budget (PGB)</items></term_definitions><term_definitions code="at0011"><items id="description">Wlz-zorg thuis inclusief maaltijden en welzijn.</items><items id="text">Volledig Pakket Thuis (VPT)</items></term_definitions><term_definitions code="at0012"><items id="description">Wlz-zorg thuis in losse modules.</items><items id="text">Modulair Pakket Thuis (MPT)</items></term_definitions><term_definitions code="at0013"><items id="description">Deels natura, deels PGB.</items><items id="text">Combinatie ZIN en PGB</items></term_definitions><term_definitions code="at0014"><items id="description">Totaal aantal geïndiceerde minuten directe en indirecte zorg per week.</items><items id="text">Geplande zorgduur per week (minuten)</items></term_definitions><term_definitions code="at0015"><items id="description">Wordt digitale/hybride zorg of beeldschermcontact ingezet?</items><items id="text">Inzet beeldschermzorg / eHealth</items></term_definitions><term_definitions code="at0016"><items id="description">Bijv. VV-4, VV-5, VV-6.</items><items id="text">Wlz-indicatieprofiel / Zorgzwaartepakket (ZZP)</items></term_definitions><term_definitions code="at0017"><items id="description">Informatie over eventuele CAK-eigen bijdrage of kosten.</items><items id="text">Financiële consequenties voor cliënt</items></term_definitions><term_definitions code="at0018"><items id="description">Toelichting op de toewijzing.</items><items id="text">Toelichting financiering</items></term_definitions><term_definitions code="at0000"><items id="description">Vastlegging van de financieringsstroom en leveringsvoorwaarden.</items><items id="text">Zorgfinanciering en leveringsvorm</items></term_definitions></children>
