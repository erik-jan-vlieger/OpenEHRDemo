                <archetype_id><value>openEHR-EHR-OBSERVATION.nursing_gordon_patterns_nl.v0</value></archetype_id><term_definitions code="at0000"><items id="description">Verpleegkundige anamnese volgens de 11 functionele gezondheidspatronen van Marjory Gordon.</items><items id="text">Gezondheidspatronen van Gordon Anamnese</items></term_definitions><term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">Event Series</items></term_definitions><term_definitions code="at0002"><items id="description">Tijdstip van anamnese.</items><items id="text">Elk evenement</items></term_definitions><term_definitions code="at0003"><items id="description">@ internal @</items><items id="text">Boom</items></term_definitions><term_definitions code="at0004"><items id="description">Gezondheidsbeleving, leefstijl, therapietrouw en veiligheidsgedrag.</items><items id="text">1. Gezondheidsbeleving en -instandshouding</items></term_definitions><term_definitions code="at0005"><items id="description">Is er op dit patroon een verpleegkundig aandachtspunt?</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0006"><items id="description">Klinische observaties en uitspraken van de cliënt.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0007"><items id="description">Eet- en drinkpatroon, gewicht, huidconditie, gebit en eetlust.</items><items id="text">2. Voedings- en stofwisselingspatroon</items></term_definitions><term_definitions code="at0008"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0009"><items id="description">Observaties voeding en stofwisseling.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0010"><items id="description">Darm- en blaasfunctie, continentie, transpiratie.</items><items id="text">3. Uitscheidingspatroon</items></term_definitions><term_definitions code="at0011"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0012"><items id="description">Observaties uitscheiding.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0013"><items id="description">Mobiliteit, ADL-zelfstandigheid, energie, vrije tijd en conditie.</items><items id="text">4. Activiteiten- en bewegingspatroon</items></term_definitions><term_definitions code="at0014"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0015"><items id="description">Observaties mobiliteit en ADL.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0016"><items id="description">Slaapkwaliteit, inslaap-/doorslaapproblemen, rustmomenten.</items><items id="text">5. Slaap- en rustpatroon</items></term_definitions><term_definitions code="at0017"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0018"><items id="description">Observaties slaap en rust.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0019"><items id="description">Geheugen, oriëntatie, zintuiglijke waarneming, pijn, oordeelsvorming.</items><items id="text">6. Cognitief en waarnemingspatroon</items></term_definitions><term_definitions code="at0020"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0021"><items id="description">Observaties cognitie, pijn en zintuigen.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0022"><items id="description">Zelfwaardering, lichaamsbeeld, stemming, gevoel van eigenwaarde.</items><items id="text">7. Zelfbeeld- en zelfbelevingspatroon</items></term_definitions><term_definitions code="at0023"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0024"><items id="description">Observaties zelfbeeld.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0025"><items id="description">Gezinsrelaties, sociale contacten, mantelzorg, maatschappelijke rollen.</items><items id="text">8. Rollen- en relatiepatroon</items></term_definitions><term_definitions code="at0026"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0027"><items id="description">Observaties relaties en netwerk.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0028"><items id="description">Seksuele gezondheid, intimiteit, voortplanting en beleving.</items><items id="text">9. Seksualiteits- en voortplantingspatroon</items></term_definitions><term_definitions code="at0029"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0030"><items id="description">Observaties seksualiteit en intimiteit.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0031"><items id="description">Omgaan met stress, verlies, ziekte, draagkracht, veerkracht.</items><items id="text">10. Coping- en stresstolerantiepatroon</items></term_definitions><term_definitions code="at0032"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0033"><items id="description">Observaties coping en veerkracht.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0034"><items id="description">Levensvisie, religie, ethische normen, wat het leven betekenis geeft.</items><items id="text">11. Waarden- en overtuigingenpatroon</items></term_definitions><term_definitions code="at0035"><items id="description">Aandachtspunt aanwezig.</items><items id="text">Afwijking of risico aanwezig</items></term_definitions><term_definitions code="at0036"><items id="description">Observaties waarden en overtuigingen.</items><items id="text">Bevindingen en toelichting</items></term_definitions><term_definitions code="at0037"><items id="description">Algehele samenvattende verpleegkundige conclusie over de 11 patronen.</items><items id="text">Samenvatting anamnese</items></term_definitions><term_definitions code="at0000"><items id="description">Verpleegkundige anamnese volgens de 11 functionele gezondheidspatronen van Marjory Gordon.</items><items id="text">Gezondheidspatronen van Gordon Anamnese</items></term_definitions></children>
